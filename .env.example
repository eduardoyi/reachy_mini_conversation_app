# Realtime provider: "huggingface" (default), "gemini", or "openai_live".
# REALTIME_PROVIDER="huggingface"

# Gemini Live API key; required only when REALTIME_PROVIDER="gemini".
# GEMINI_API_KEY=
# Optional Gemini Live model; defaults to "gemini-3.1-flash-live-preview".
# GEMINI_LIVE_MODEL=
# Optional Gemini voice; defaults to "Puck".
# GEMINI_VOICE=
# Extended Thinking is enabled only by selecting
# GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking. Levels are low, medium
# (the default for that model), or high.
# GEMINI_THINKING_LEVEL=medium

# OpenAI Live uses GPT Live for speech and Luna for tools/requested images.
# OPENAI_API_KEY=
# OPENAI_LIVE_MODEL="gpt-live-1"
# OPENAI_LIVE_BACKEND_MODEL="gpt-5.6-luna"
# OPENAI_LIVE_VOICE="marin"

# Optional household memory lifetimes and attribution. Disabled by default.
# Existing v1 memory requires explicit migration; see docs/features/household-memory.md.
# This enables local tools/storage only, not background extraction or daily review.
# HOUSEHOLD_MEMORY_ENABLED=0
# Optional silent extraction from active GPT Live or Gemini Live conversations (uses OPENAI_API_KEY).
# Requires household memory; with face recognition, notes are attributed to the recognized speaker.
# Bounded to 300 requests/day; no capture or processing while in standby.
# HOUSEHOLD_MEMORY_CAPTURE_ENABLED=0
# Optional once-per-day tidy-up (merge duplicates, promote lasting notes) during an active conversation.
# Requires HOUSEHOLD_MEMORY_ENABLED and stays disabled by default.
# HOUSEHOLD_MEMORY_REVIEW_ENABLED=0

# Speaker output: "sdk" (default) uses Reachy Mini's normal media path.
# "gstreamer" uses an app-owned Mac/simulator speaker pipeline and avoids
# feeding assistant audio through the SDK LOCAL audiomixer. This is opt-in.
# AUDIO_OUTPUT_BACKEND="sdk"

# Optional local ambient runtime. Disabled by default to preserve direct provider behavior.
# HYBRID_RUNTIME_ENABLED=0
# Cloud session inactivity timeout in seconds. Default 60; 0 disables automatic close.
# HYBRID_CLOUD_INACTIVITY_SECONDS=60
# Keep listening for a follow-up this long after Reachy replies; 0 disables (only the inactivity rule applies).
# HYBRID_FOLLOW_UP_SECONDS=15
# Longer windows for people who need more time to answer, recognized by face (person IDs from Settings > Faces).
# HYBRID_FOLLOW_UP_BY_PERSON=enzo=45
# Ask OpenAI (OPENAI_API_KEY) whether people are still talking to Reachy so he leaves side conversations early.
# HYBRID_ADDRESSEE_CHECK_ENABLED=1
# Ambient PCM ring duration in seconds. Capped at 20 seconds; default 20.
# HYBRID_AMBIENT_BUFFER_SECONDS=20

# Optional local ambient transcription. The endpoint is restricted to this
# machine's loopback interface; raw ambient audio is never sent to a cloud provider.
# Strategy "continuous" enables local transcript context, voice wake, and local
# commands. Strategy "activation" transcribes the RAM ring only after keyboard
# activation and therefore keeps voice wake disabled.
# LOCAL_CONTEXT_STRATEGY="continuous"
# LOCAL_STT_BASE_URL="http://127.0.0.1:8766/v1"
# LOCAL_STT_MODEL="openai/whisper-small"
# LOCAL_STT_TIMEOUT_SECONDS=5
# LOCAL_VAD_RMS_THRESHOLD=500
# LOCAL_VAD_SILENCE_SECONDS=0.6
# Local transcript wake phrase; exact matching defaults to Reachy.
# LOCAL_WAKE_WORD="Reachy"
# LOCAL_WAKE_COOLDOWN_SECONDS=2
# After a wake-only final transcript, wait this many seconds for one command
# final before opening the selected cloud provider. Default 5 seconds; maximum 15 seconds.
# LOCAL_WAKE_FOLLOWUP_TIMEOUT_SECONDS=5
# Rolling local transcript retention in seconds. This is text-only and is
# independent from the 20-second raw PCM ring. Default 60.
# LOCAL_CONTEXT_WINDOW_SECONDS=60
# LOCAL_CONTEXT_MAX_CHARS=2000
# Optional diagnostic preview of the bounded local transcript in the browser.
# It is disabled by default; the preview is available only through the
# loopback-only GET /api/transcript-preview endpoint and adds no cloud traffic.
# LOCAL_TRANSCRIPT_PREVIEW_ENABLED=0

# Optional realtime input transcription language.
# Defaults to "en". Set to a backend-supported code such as "zh" for Chinese.
# REALTIME_TRANSCRIPTION_LANGUAGE="en"   # or "auto" for a multilingual household
# LOCAL_STT_LATIN_ONLY=1   # drop non-Latin Whisper hallucinations (Latin-script households)

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# Supervised official33 simulator trial, disabled by default. Assets remain private.
LOCAL_ACOUSTIC_WAKE_ENABLED=0
# Directory containing the hash-verified official33 model and two ONNX backbones.
LOCAL_ACOUSTIC_WAKE_MODEL_DIR=
# Wake model score that counts as a possible call (default 0.5). With LOCAL_STT_REQUEST_MODEL set,
# Whisper checks the name in the wake audio before Reachy reacts, so a low value such as 0.3 catches
# far calls without false wakes.
# LOCAL_ACOUSTIC_WAKE_THRESHOLD=0.5
# Save short local clips around wake events to retrain the wake word (needs the acoustic wake).
# Records everyone in the room; clips stay on this computer and are deleted after the keep period.
WAKE_CLIPS_ENABLED=0
# WAKE_CLIPS_KEEP_DAYS=14
# Bending an antenna wakes Reachy as saying his name does (hybrid runtime). On by default.
# ANTENNA_TOUCH_WAKE=1

# Optional Spotify control; both settings are required. Tokens stay outside the repository.
SPOTIFY_CREDENTIALS_FILE=
SPOTIFY_DEVICE_ID=
# Volume (0-100) for music while a wake-word conversation is open; restored afterwards.
# SPOTIFY_DUCK_VOLUME_PERCENT=20

# Supervised audio timing comparison (metadata only; restart to apply).
AUDIO_DIAGNOSTICS_ENABLED=0
SPEECH_WOBBLE_ENABLED=1

# Turn toward whoever is talking and follow their face during conversations.
SPEAKER_FOLLOWING_ENABLED=1

# Recognize enrolled household members on camera, locally ("remember my face, I'm Ana").
FACE_RECOGNITION_ENABLED=0

# IKEA DIRIGERA hub for lights and plugs. Set both by pairing:
#   .venv/bin/python -m reachy_mini_conversation_app.dirigera_hub pair
# DIRIGERA_HOST=gw2-xxxxxxxxxxxx.local
# DIRIGERA_TOKEN=
# Tuya / Smart Life devices with local keys from TinyTuya's wizard (kept outside the repository).
# TUYA_DEVICES_FILE=~/.config/reachy-tuya/devices.json
# Rooms for devices without one and areas within rooms, e.g.
# {"rooms": {"TV Lights": "Living room"}, "areas": {"Dining": ["Dining light 1", "Dining lamp"]}}
# HOME_LAYOUT_FILE=~/.config/reachy-home/layout.json
# Everyday commands (lights, music, TV, time, date, weather) answered locally in about a second,
# without opening the Gemini conversation. Set QUICK_COMMANDS_ENABLED=0 to send everything to Gemini.
# QUICK_COMMANDS_ENABLED=1
# More accurate local Whisper model for what is said right after "Reachy" (the launcher loads it too).
# LOCAL_STT_REQUEST_MODEL=openai/whisper-large-v3-turbo
# Debugging: print what was said when a request goes to Gemini instead (words appear in the log).
# QUICK_COMMANDS_LOG_TEXT=0
# Reply voice: Gemini text-to-speech in GEMINI_VOICE.
# LOCAL_SPEECH_MODEL=gemini-3.8-flash-lite-tts
# Home place for weather (coordinates skip the lookup).
# HOME_LOCATION=Lisbon
# HOME_LATITUDE=38.768
# HOME_LONGITUDE=-9.095
# Bluetooth speaker the Mac plays Spotify through (set by
#   .venv/bin/python -m reachy_mini_conversation_app.music_speaker setup "Living Room Speaker")
# MUSIC_SPEAKER_BLUETOOTH=aa-bb-cc-dd-ee-ff
# MUSIC_SPEAKER_OUTPUT="Living Room Speaker"
# Android / Google TV. Set by pairing (the TV shows a code; the client certificate stays in
# ANDROID_TV_CERT_DIR, outside the repository):
#   .venv/bin/python -m reachy_mini_conversation_app.android_tv pair [host]
# ANDROID_TV_HOST=Android.local
# ANDROID_TV_CERT_DIR=~/.config/reachy-tv
# Rarely used tools are offered as skills (use_skill / skill_help) to keep each turn's prompt small;
# 0 offers every tool in full, as before.
# SKILL_TOOLS_ENABLED=1
# Maribel (Grok Bot): "Richie, ask Maribel to..." goes to her webhook (key sent as a Bearer header) and
# Reachy speaks her reply, which she posts to MARIBEL_CALLBACK_URL with REACHY_CALLBACK_SECRET as a Bearer
# header. Publish the loopback server with Tailscale Funnel:
#   tailscale funnel --bg --set-path /maribel/reply http://127.0.0.1:8791/maribel/reply
# MARIBEL_WEBHOOK_URL=
# MARIBEL_WEBHOOK_KEY=
# MARIBEL_CALLBACK_URL=https://<this-mac>.<tailnet>.ts.net/maribel/reply
# REACHY_CALLBACK_SECRET=
# MARIBEL_CALLBACK_PORT=8791
# TRMNL e-ink display. The app serves its screens; in the TRMNL's Wi-Fi setup page set
# Advanced > API Server to http://<this-computer's-LAN-IP>:<TRMNL_PORT>.
# TRMNL_ENABLED=1
# TRMNL_PORT=8090
# Seconds the TRMNL sleeps between check-ins; 1 on USB power. Raise it (e.g. 900) on battery.
# TRMNL_REFRESH_SECONDS=1
# Show the song Spotify plays on Reachy's speaker (album art, title, artist, album); 0 turns it off.
# DISPLAY_NOW_PLAYING=1
# Drawings and photo edits use OPENAI_API_KEY with a gpt-image-* model, or GEMINI_API_KEY with a Gemini
# image model (for example gemini-3.1-flash-lite-image); a subject drawn before comes from the cache.
# DISPLAY_IMAGE_MODEL=gpt-image-2.5-flare
# Web pictures: Brave Image Search finds them and Jev (TypeSafe) checks each is fine for young children.
# Both keys are needed; without them pictures are drawn instead.
# BRAVE_API_KEY=
# TYPESAFE_API_KEY=
# DISPLAY_CHECK_MODEL=jev-latest

# AI cost estimates use built-in list prices; override or add models with a JSON file of USD per 1M tokens:
# {"gemini-3.8-live": {"input_audio": 3.0, "output_audio": 12.0}}
# USAGE_PRICES_FILE=~/.config/reachy-home/prices.json

# Experimental local microphone interruption test; native override requires the reviewed SDK fix.
GEMINI_LIVE_LOCAL_BARGE_IN_ENABLED=0
# Stream the camera to Gemini (1 frame/s) while the user is talking and for 30 s after.
# Requires gemini-3.8-live-extended-thinking. Sends video to Google; about $0.90 per streamed hour.
GEMINI_LIVE_VIDEO_ENABLED=0
OPENAI_LIVE_LOCAL_BARGE_IN_ENABLED=0
MACOS_LOCAL_AUDIO_FLUSH_ENABLED=0
